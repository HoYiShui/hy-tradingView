# Server
PORT=8787
BACKPACK_API_URL=https://api.backpack.exchange

# Accounts. ACCOUNTS lists the ids, lowercase letters and digits only.
# Each id needs ACCOUNT_<ID>_EXCHANGE, _LABEL, _SURFACES and that exchange's credentials.
# SURFACES is a comma list of dashboard (the / page) and replay (the /replay page).
# Data is stored per account in data/<id>.db.
ACCOUNTS=live,sandbox

# backpack credentials: API_KEY is the base64 ED25519 public key, API_SECRET is the
# base64 ED25519 seed. Use read-only keys.
ACCOUNT_LIVE_EXCHANGE=backpack
ACCOUNT_LIVE_LABEL=Live
ACCOUNT_LIVE_API_KEY=replace-with-api-key
ACCOUNT_LIVE_API_SECRET=replace-with-api-secret
ACCOUNT_LIVE_SURFACES=dashboard

ACCOUNT_SANDBOX_EXCHANGE=backpack
ACCOUNT_SANDBOX_LABEL=Sandbox
ACCOUNT_SANDBOX_API_KEY=replace-with-api-key
ACCOUNT_SANDBOX_API_SECRET=replace-with-api-secret
ACCOUNT_SANDBOX_SURFACES=replay

# A third account on another exchange. Only backpack is implemented today, so keep
# this commented out until an adapter for its exchange exists.
# ACCOUNTS=live,sandbox,perp
# ACCOUNT_PERP_EXCHANGE=hyperliquid
# ACCOUNT_PERP_LABEL=Perp strategy
# ACCOUNT_PERP_WALLET_ADDRESS=replace-with-0x-address
# ACCOUNT_PERP_PRIVATE_KEY=replace-with-private-key
# ACCOUNT_PERP_SURFACES=dashboard,replay
